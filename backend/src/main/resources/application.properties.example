# =============================================================================
# English Lab - Plantilla de configuración (sin credenciales reales).
# Referencia para `application.properties` (excluido de Git).
# =============================================================================

# --- Servidor ---
server.port=8080

# --- Datasource PostgreSQL (puerto 5432) ---
spring.datasource.url=jdbc:postgresql://localhost:5432/englishlab
spring.datasource.username=${DB_USERNAME:}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver

# --- JPA / Hibernate (schema gestionado SOLO por Flyway) ---
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

# --- Flyway ---
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# --- JWT (secreto SIEMPRE desde la variable de entorno; sin valor por defecto) ---
# JWT_SECRET debe tener al menos 256 bits (32 bytes) para HMAC-SHA256.
app.jwt.secret=${JWT_SECRET}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:3600000}

# --- Auth ---
# Log del token de recuperación SOLO para desarrollo local (NUNCA en despliegue).
app.auth.log-reset-token=${AUTH_LOG_RESET_TOKEN:false}

# Log del enlace de verificación SOLO para desarrollo local (NUNCA en despliegue).
app.auth.log-verification-link=${AUTH_LOG_VERIFICATION_LINK:false}

# --- Correo ---
# Producción (VPS Contabo): Postfix local, sin autenticación ni proveedor externo.
#   MAIL_HOST=127.0.0.1  MAIL_PORT=25  MAIL_ENABLED=true  MAIL_FROM=noreply@english-labeq15.tech
# En entornos Docker, 127.0.0.1 apunta al propio contenedor y corresponde usar la IP del host.
spring.mail.host=${MAIL_HOST:127.0.0.1}
spring.mail.port=${MAIL_PORT:25}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=10000
spring.mail.properties.mail.smtp.writetimeout=10000
app.mail.enabled=${MAIL_ENABLED:false}
app.mail.from=${MAIL_FROM:noreply@english-labeq15.tech}

# --- Verificación de correo ---
# URL pública del frontend: el enlace del correo será <base><path>?token=...
# Debe ser HTTPS (http solo se admite en localhost para desarrollo).
app.verification.frontend-base-url=${APP_FRONTEND_URL:https://english-labeq15.tech}
app.verification.path=/verificar-correo
app.verification.token-ttl=${VERIFICATION_TOKEN_TTL:24h}
app.verification.resend-cooldown=${VERIFICATION_RESEND_COOLDOWN:60s}
app.verification.max-sends-per-hour=${VERIFICATION_MAX_SENDS_PER_HOUR:5}
app.verification.unverified-retention=${VERIFICATION_UNVERIFIED_RETENTION:7d}

# --- Google (registro / inicio de sesión con Google) ---
# OAuth Client ID de tipo "Web" creado en Google Cloud Console (es público, no es un secreto).
# Debe ser el MISMO que VITE_GOOGLE_CLIENT_ID del frontend. Vacío = el endpoint /auth/google responde 503.
# Orígenes de JavaScript autorizados: https://english-labeq15.tech (y http://localhost:5173 en desarrollo).
# El servidor necesita salida HTTPS a www.googleapis.com para descargar las claves públicas de Google.
app.google.client-id=${GOOGLE_CLIENT_ID:}

# --- Recuperación de contraseña por SMS (Twilio Verify API) ---
# Credenciales siempre desde variables de entorno. Con TWILIO_VERIFY_ENABLED=false la función queda desactivada.
twilio.verify.enabled=${TWILIO_VERIFY_ENABLED:false}
twilio.verify.account-sid=${TWILIO_ACCOUNT_SID:}
twilio.verify.auth-token=${TWILIO_AUTH_TOKEN:}
twilio.verify.service-sid=${TWILIO_VERIFY_SERVICE_SID:}
